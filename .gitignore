# Secrets: copy .env.example to .env and put your own key there
.env

# Downloaded by `uv run topodockq-setup` (never committed)
data/*
!data/.gitkeep

# authors_code/: only the authors' MIT-licensed TopoDockQ repository is committed (unmodified);
# anything else kept there locally (e.g. other copies, the paper PDF) stays out of git.
authors_code/*
!authors_code/TopoDockQ/

# Run outputs
runs/

# Environments
.venv/
.venv-prody/
.venv-feature38/

# Private working notes
PROJECT_NOTES.md

# Python / tooling
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# ...except the authors' compiled files, which are part of their published code and must ship unchanged
!authors_code/TopoDockQ/**/*.pyc
!authors_code/TopoDockQ/**/__pycache__/
