# Copy this file to .env and put your own key in it:
#   macOS/Linux:  cp .env.example .env        Windows (PowerShell):  Copy-Item .env.example .env
# .env is git-ignored. Never commit a real key.

# Your Anthropic API key (create one at https://console.anthropic.com -> API Keys).
# This is the ONLY credential the agents use; a system-wide ANTHROPIC_API_KEY is deliberately ignored.
TOPODOCKQ_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model for every agent. claude-sonnet-5-5 is a good default; claude-opus-5-5 is stronger and costs more.
TOPODOCKQ_MODEL=claude-sonnet-5-5

# Optional settings
# TOPODOCKQ_MAIN_MODEL=claude-opus-5-5     # per-agent model: TOPODOCKQ_{MAIN,DATA,TOPO,ML}_MODEL
# TOPODOCKQ_MAIN_EFFORT=high               # per-agent effort: low | medium | high | xhigh | max
# TOPODOCKQ_INPUT=data/external/PFPD_AF2_models
# TOPODOCKQ_WORKERS=8                      # structures processed in parallel
# TOPODOCKQ_VERIFY=1                       # re-run the deterministic pipeline after each agent run and compare
# TOPODOCKQ_RUNS_DIR=./runs
# TOPODOCKQ_FALLBACKS=1                    # server-side refusal fallbacks
